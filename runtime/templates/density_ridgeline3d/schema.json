{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "template_id": "density_ridgeline3d",
  "layout": "precomputed_dual_density_mixed_wide",
  "required_roles": [
    "condition_id",
    "condition_position",
    "density_x",
    "density_solid",
    "density_dashed",
    "focal_x"
  ],
  "optional_roles": [],
  "axis_roles_requiring_semantic_name_and_unit": [
    "density_x",
    "condition_position",
    "density_solid",
    "density_dashed"
  ],
  "density_role_semantics": "both_headers_must_explicitly_identify_density_or_密度",
  "density_unit_contract": "both_headers_must_use_the_same_normalized_unit_or_both_explicitly_dimensionless",
  "z_title_contract": "Density (<normalized shared unit>)",
  "min_conditions": 2,
  "max_conditions": 6,
  "condition_id_maps_to_one_condition_position": true,
  "condition_position_maps_to_one_condition_id": true,
  "condition_axis_year_aliases_use_implicit_unit": ["Year", "年份", "年度"],
  "condition_position_order": "strictly_increasing_by_condition_first_appearance_in_source",
  "min_points_per_condition": 5,
  "density_columns": ["density_solid", "density_dashed"],
  "density_constraint": "both_complete_finite_nonnegative_with_explicit_matching_units_on_every_row",
  "density_x_order": "strictly_monotonic_within_each_condition_in_source_order",
  "density_x_direction_across_conditions": "all_conditions_must_share_increasing_or_decreasing_direction",
  "focal_x_constraint": "exactly_one_finite_nonempty_value_per_condition_and_inside_condition_density_x_range",
  "threshold_named_column_requires_user_confirmation_as_focal_x": true,
  "focal_z": 0,
  "automatic_density_calculation": false,
  "automatic_kde": false,
  "automatic_interpolation": false,
  "automatic_focal_calculation": false,
  "min_columns": 6,
  "min_rows": 10,
  "supported_extensions": [".csv", ".txt", ".xls", ".xlsx"]
}
